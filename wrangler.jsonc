{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scadium-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Zone route rather than a custom domain — see apps/web/wrangler.jsonc for why.
  "routes": [{ "pattern": "api.scadium.com/*", "zone_name": "scadium.com" }],

  // The API + BullMQ worker, as one long-lived container built from the image the
  // project already had. max_instances is 1 on purpose: leader election has no
  // request-forwarding, so a second replica would reject gameplay writes (H12).
  // image_build_context is the repo root because apps/api/Dockerfile does `COPY . .`
  // to install the whole pnpm workspace.
  "containers": [
    {
      "class_name": "ScadiumApi",
      "image": "./apps/api/Dockerfile",
      "image_build_context": ".",
      // Custom instance: a FULL vCPU. `basic` gives 1/4 vCPU, on which this image
      // takes ~36s to open its port — and @cloudflare/containers only waits 20s,
      // so every cold start failed. Boot is CPU-bound (NestJS graph of ~40 modules
      // plus `prisma migrate deploy`), so cores are what matter, not memory.
      // Custom types require >= 1 vCPU and >= 3 GiB per vCPU; disk <= 2 GB per GiB.
      // At ~73 container-hours/month this costs ~$1.90/mo against the plan's
      // included 25 GiB-hours — see the cost model in the migration spec §7.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 6144 },
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "SCADIUM_API", "class_name": "ScadiumApi" }]
  },

  // Containers require a SQLite-backed Durable Object class.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScadiumApi"] }],

  // Hourly sweep of the 9 economy jobs. This is the scheduling guarantee once the
  // container is allowed to sleep; see the migration spec §5.2.
  "triggers": { "crons": ["0 * * * *"] },

  // SLEEP_AFTER is load-bearing for the BUDGET, not just for container cost.
  // The crash engine writes a round every ~10-20s while it is up, so Neon's
  // compute-time tracks container uptime almost exactly. With the hourly cron:
  //   10m -> ~134 container-hours/month  (OVER Neon free's 100 CU-hours)
  //    5m -> ~73  container-hours/month  (under, with headroom for real visitors)
  // Raising it improves cold-start UX and costs Neon compute-hours. See spec §8.4/§8.6.
  //
  // Non-secret configuration. Secrets go in with `wrangler secret put` and are
  // never committed: DATABASE_URL, JWT_SECRET, INTERNAL_JOB_SECRET, METRICS_TOKEN,
  // GEO_IP_SALT, GEO_PROXY_SECRET.
  "vars": {
    "PROCESS_MODE": "both",
    // Rotate (-v3, -v4, …) to get a clean Durable Object if the container wedges.
    "CONTAINER_INSTANCE": "scadium-api-v2",
    "SLEEP_AFTER": "5m",
    "CORS_ORIGIN": "https://scadium.com",
    "API_ORIGIN": "https://api.scadium.com",
    "SOLANA_NETWORK": "devnet"
  }
}
