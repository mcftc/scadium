# Build-time public configuration for the Cloudflare Workers deployment.
# NEXT_PUBLIC_* values are inlined into the client bundle, so none of these are
# secrets. They live here rather than in a build command so the origins are
# versioned config with one source of truth.
NEXT_PUBLIC_API_URL=https://api.scadium.com
NEXT_PUBLIC_WS_URL=wss://api.scadium.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_APP_NAME=Scadium
